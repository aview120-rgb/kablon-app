{
  "name": "lema-hayakara",
  "version": "1.0.0",
  "description": "לאמא היקרה – ממיר תמונות, לוגואים וטקסט לקבצי רקמה",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node test/run-all.mjs",
    "assets": "node scripts/fetch-assets.mjs && node scripts/copy-ort.mjs",
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "android:sync": "vite build && npx cap sync android"
  },
  "keywords": [],
  "author": "LeImaHayakara",
  "license": "ISC",
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "bidi-js": "^1.1.0",
    "electron-updater": "^6.8.11",
    "harfbuzzjs": "^1.6.4",
    "onnxruntime-web": "^1.31.1",
    "pdfjs-dist": "^4.10.38"
  },
  "type": "module",
  "productName": "LeImaHayakara",
  "build": {
    "appId": "com.lemahayakara.app",
    "productName": "LeImaHayakara",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/models/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon-1024.png",
      "artifactName": "LeImaHayakara-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "לאמא היקרה",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "LeImaHayakara-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aview120-rgb",
        "repo": "kablon-app",
        "releaseType": "release"
      }
    ]
  }
}
