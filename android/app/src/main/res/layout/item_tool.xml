<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Kablon.Card">
    <TextView android:id="@+id/toolCategory" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:alpha="0.7" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/toolName" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/toolStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/toolDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="6dp">
        <Button android:id="@+id/toolOpen" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="פתח" android:layout_marginEnd="6dp" />
        <Button android:id="@+id/toolInstall" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="התקן / עדכן" />
    </LinearLayout>
    <LinearLayout android:id="@+id/toolExtra" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone">
        <Button android:id="@+id/toolExtra1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginEnd="6dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        <Button android:id="@+id/toolExtra2" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
    </LinearLayout>
</LinearLayout>
