{
  "name": "kosher-til-server",
  "version": "1.0.0",
  "private": true,
  "description": "Management server + admin panel for the Kosher-Til content filter",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute kosher_til --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute kosher_til --file=./schema.sql --local"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
